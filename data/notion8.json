          "title": "Relation avec le nombre stérique",
          "list": [
            "Nombre stérique = 2 → sp",
            "Nombre stérique = 3 → sp²",
            "Nombre stérique = 4 → sp³",
            "Nombre stérique = 5 → sp³d",
            "Nombre stérique = 6 → sp³d²"
          ]
        }
