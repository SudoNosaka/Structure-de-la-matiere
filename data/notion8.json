    {
      "id": "hybridation",
      "title": "Hybridation des Orbitales",
      "content": "L'hybridation explique la géométrie des molécules en combinant les orbitales atomiques.",
      "subsections": [
        {
          "title": "Types d'hybridation",
          "table": [
            {"hybridation": "sp", "orbitales": "1s + 1p", "geometrie": "Linéaire", "angle": "180°", "exemple": "CO₂, BeCl₂"},
            {"hybridation": "sp²", "orbitales": "1s + 2p", "geometrie": "Trigonale plane", "angle": "120°", "exemple": "BF₃, C₂H₄"},
            {"hybridation": "sp³", "orbitales": "1s + 3p", "geometrie": "Tétraédrique", "angle": "109,5°", "exemple": "CH₄, NH₃"},
            {"hybridation": "sp³d", "orbitales": "1s + 3p + 1d", "geometrie": "Bipyramidale trigonale", "angle": "90°, 120°", "exemple": "PCl₅"},
