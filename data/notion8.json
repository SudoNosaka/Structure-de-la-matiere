    {
      "id": "polarite",
      "title": "Polarité des Molécules",
      "content": "Une molécule est polaire si elle possède un moment dipolaire global non nul.",
      "subsections": [
        {
          "title": "Conditions",
          "list": [
            "Présence de liaisons polaires (Δχ ≠ 0)",
            "Géométrie asymétrique (les moments dipolaires ne s'annulent pas)"
          ]
        },
        {
          "title": "Exemples",
          "table": [
            {"molecule": "H₂O", "polarite": "Polaire", "raison": "Géométrie coudée, moments dipolaires ne s'annulent pas"},
            {"molecule": "CO₂", "polarite": "Apolaire", "raison": "Géométrie linéaire, moments dipolaires s'annulent"},
            {"molecule": "NH₃", "polarite": "Polaire", "raison": "Géométrie pyramidale, moment dipolaire non nul"},
            {"molecule": "CH₄", "polarite": "Apolaire", "raison": "Géométrie tétraédrique symétrique"},
            {"molecule": "CCl₄", "polarite": "Apolaire", "raison": "Géométrie tétraédrique symétrique"}
          ]
        },
        {
          "title": "Conséquences de la polarité",
          "list": [
            "Point d'ébullition plus élevé (interactions dipôle-dipôle)",
            "Solubilité dans les solvants polaires (eau)",
            "Réactivité chimique influencée"
          ]
        }
      ]
    },
    {
      "id": "methodologie",
      "title": "Méthodologie Complète",
      "content": "Pour déterminer la géométrie d'une molécule :",
      "method": [
        "Écrire la structure de Lewis",
        "Compter le nombre de doublets autour de l'atome central (liants + non-liants)",
        "Déterminer le nombre stérique",
        "Identifier la géométrie de base (table VSEPR)",
        "Ajuster selon les doublets non-liants",
        "Déterminer l'hybridation",
        "Évaluer la polarité (symétrie + liaisons polaires)"
      ],
      "example": "NH₃ : 3 liaisons N-H + 1 doublet non-liant → AX₃E₁ → pyramidale trigonale → sp³ → polaire"
    }
  ]
